---
import AppLayout from "@/layout/AppLayout.astro";
import MainLayout from "@/layout/MainLayout.astro";
import { ManagePropertyPages } from "@/components/form/ManagePropertyPages";
import { PUBLIC_API_URL } from "@/constant"

const token = Astro.cookies.get("session")?.value;

---
<AppLayout>
    <title slot="head">Manage Properties | RealEstate by Alfath Muqoddas</title>
    <meta slot="head" name="title" content="Manage Properties | RealEstate by Alfath Muqoddas" />
    <meta slot="head" name="description" content="Manage Properties | RealEstate by Alfath Muqoddas" />
<MainLayout>
    <div class="flex justify-between gap-4 items-center mb-4">
        <div>
            <h1 class="text-2xl font-bold text-primary">Manage Properties</h1>
            <p class="text-sm text-muted-foreground">Manage your properties</p>
        </div>
        <a href="/manage-properties/add">
            <button class="bg-primary px-3 py-1 text-white rounded-lg">+ Add new property</button>
        </a>
    </div>
    <ManagePropertyPages token={token} PUBLIC_API_URL={PUBLIC_API_URL} client:load />
</MainLayout>
</AppLayout>