---
import AppLayout from "@/layout/AppLayout.astro";
import MainLayout from "@/layout/MainLayout.astro";
import {EditPropertyPage} from "@/components/form/EditPropertyPage";
import { PUBLIC_API_URL } from "@/constant"

const token = Astro.cookies.get("session")?.value;
const {id: propertyId} = Astro.params;

---
<AppLayout>
    <title slot="head">Edit Property | RealEstate by Alfath Muqoddas</title>
    <meta slot="head" name="title" content="Edit Property | RealEstate by Alfath Muqoddas" />
    <meta slot="head" name="description" content="Edit Property | RealEstate by Alfath Muqoddas" />
    <MainLayout>
        <div class="mb-4">
            <h1 class="text-2xl font-bold text-primary">Edit Property</h1>
            <p class="text-sm text-muted-foreground">Edit a property</p>
        </div>
        <EditPropertyPage propertyId={propertyId} token={token} PUBLIC_API_URL={PUBLIC_API_URL} client:only="react" />
    </MainLayout>
</AppLayout>
